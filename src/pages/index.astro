      .mission h1 { font-size:28px; margin:0 0 12px; }
      .mission p { margin:10px 0; max-width:44rem; }
      .principles { margin:14px 0 0; padding:0; list-style:none; color:var(--muted); font-size:15px; }
      .principles li { padding:3px 0 3px 24px; position:relative; }
      .principles li::before { content:"→"; position:absolute; left:0; color:var(--accent); }
      section { margin-top:44px; }
      h2.label { font-size:13px; letter-spacing:0.16em; text-transform:uppercase; color:var(--accent); margin:0 0 14px; font-weight:800; }
      .grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:14px; }
      .card { background:var(--card); border:1px solid rgba(238,247,245,0.12); border-radius:12px; padding:16px 18px; }
      .grid .card { margin:0; }
      .card strong { font-size:16px; }
      .card .desc { color:var(--muted); font-size:14px; margin-top:6px; }
      ul.acts { list-style:none; margin:0; padding:0; }
      ul.acts li { padding:12px 0; border-bottom:1px solid rgba(238,247,245,0.1); }
      ul.acts li:last-child { border-bottom:none; }
      ul.acts .desc { color:var(--muted); font-size:14px; margin-top:3px; }
      footer { margin-top:56px; border-top:1px solid rgba(238,247,245,0.14); padding-top:20px; color:var(--muted); font-size:14px; }
      footer .ta-line { color:var(--accent); font-weight:700; }
