    <style>
      :root { --bg:#0b2e2f; --fg:#eef7f5; --muted:#c9e4e0; --accent:#f0b429; --accent-alt:#8fd0c8; --card:rgba(17,52,53,0.85); }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--fg); font-family:Inter,'Noto Sans Tamil',system-ui,sans-serif; line-height:1.65; -webkit-font-smoothing:antialiased; }
      a { color:var(--accent); text-decoration:none; }
      a:hover { text-decoration:underline; }
      .wrap { max-width:840px; margin:0 auto; padding:0 20px 64px; }
      header { border-bottom:1px solid rgba(238,247,245,0.14); padding:28px 0 22px; }
      .wordmark { font-size:26px; font-weight:800; letter-spacing:0.14em; }
      .wordmark .ta { color:var(--accent-alt); font-weight:600; letter-spacing:0; margin-left:10px; }
      nav.links { margin-top:14px; font-size:14px; display:flex; gap:18px; flex-wrap:wrap; }
      nav.links a { color:var(--accent-alt); font-weight:600; }
